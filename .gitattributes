# 统一换行符:仓库内一律 LF,避免跨平台伪 diff
* text=auto eol=lf

# Windows 专用文件保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做任何转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.glb binary
*.gltf binary
*.ply binary
*.woff binary
*.woff2 binary
*.ttf binary

# 生成文件
pnpm-lock.yaml linguist-generated=true
